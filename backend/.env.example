APP_ENV=development
# Supabase Session Pooler URI. Replace [YOUR-PASSWORD] with the new
# database password (URL-encode reserved characters). Never commit the real URI.
DATABASE_URL=postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@POOLER_HOST:5432/postgres
# For local MySQL development instead, use:
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/rivora
JWT_SECRET_KEY=replace-with-a-long-random-secret
FAST2SMS_API_KEY=

# Comma-separated frontend origins; same-origin deployments do not need this.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
