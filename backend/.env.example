
# Supabase Session Pooler URI. Replace [YOUR-PASSWORD] with the new
# database password (URL-encode reserved characters). Never commit the real URI.
DATABASE_URL=postgresql://postgres.fqdyputgxlckmnlaclzw:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# For local MySQL development instead, use:
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/rivora
JWT_SECRET_KEY=replace-with-a-long-random-secret
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Google Sheets export (keep service-account credentials out of Git)
GOOGLE_SHEET_ID=
GOOGLE_SHEET_WORKSHEET=Sheet1
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# On Render, paste the full service-account JSON into this secret variable instead.
GOOGLE_SERVICE_ACCOUNT_JSON=
