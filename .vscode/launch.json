{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Rivora Backend (FastAPI)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}/backend",
      "jinja": true,
      "justMyCode": true,
      "envFile": "${workspaceFolder}/backend/.env"
    }
  ]
}
